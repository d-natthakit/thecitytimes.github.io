{% extends "base.html.j2" %}
{#- List of every edition, newest first. -#}
{% block title %}{{ paper }} · Archive{% endblock %}
{% block dateline %}
    <span>Archive</span>
    <span>{{ issues | length }} edition{{ "s" if issues | length != 1 }}</span>
    <span>Bangkok Edition</span>
{% endblock %}
{% block content %}
<section>
  <h2 class="kicker">All Editions</h2>
  <ul class="archive-list">
    {% for i in issues %}<li>
      <span class="d">{{ i.date_long }}</span>
      <a href="issues/{{ i.date }}.html">{{ i.headline }}</a>
    </li>
    {% endfor %}
  </ul>
</section>
{% endblock %}
{% block footer %}{{ paper }} · Archive{% endblock %}
