{% extends "base.html.j2" %}
{% block title %}{{ paper }} · {{ plan.date_long }}{% endblock %}
{% block description %}{{ plan.date_long }}: {{ c.cover.headline | plain }}{% endblock %}
{% block nav %}{% if prev %}<a href="{{ root }}issues/{{ prev }}.html">&larr; Previous day</a>{% endif %}{% endblock %}
{% block dateline %}
    <span>{{ plan.date_long }}</span>
    <span>Bangkok Edition</span>
{% endblock %}

{% macro meta(level, words) -%}
<p class="meta"><span class="level">{{ level }} · {{ words | minutes }} min</span></p>
{%- endmacro %}

{% macro article(a, level, words) -%}
<article>
  <h3>{{ a.headline | md }}</h3>
  {{ meta(level, words) }}
  {% for p in a.paragraphs %}<p>{{ p | md }}</p>
  {% endfor %}
</article>
{%- endmacro %}

{% block content %}
<section class="cover">
  <h2 class="kicker">Cover Story</h2>
  <article>
    <h3>{{ c.cover.headline | md }}</h3>
    {{ meta("C1", sizes.cover) }}
    <div class="cols">
      {% for p in c.cover.paragraphs %}<p{% if loop.first %} class="dropcap"{% endif %}>{{ p | md }}</p>
      {% endfor %}
    </div>
  </article>
</section>

<section class="grid2">
  <div class="stack">
    <h2 class="kicker">World in Brief</h2>
    {% for a in c.world %}{{ article(a, "B1+", sizes["world_" ~ loop.index]) }}
    {% endfor %}
  </div>
  <div class="stack">
    <h2 class="kicker">Thailand Today</h2>
    {% for a in c.thailand %}{{ article(a, "B1+", sizes["thailand_" ~ loop.index]) }}
    {% endfor %}
  </div>
</section>

<section class="feature">
  <h2 class="kicker">Feature · {{ plan.feature }}</h2>
  <article>
    <h3>{{ c.feature.headline | md }}</h3>
    {{ meta("B2", sizes.feature) }}
    <div class="cols">
      {% for p in c.feature.paragraphs %}<p>{{ p | md }}</p>
      {% endfor %}
    </div>
  </article>
</section>

<section>
{% if c.two_takes %}{% set t = c.two_takes %}
  <h2 class="kicker">Real English · Two Takes</h2>
  <h3 class="center">{{ t.question | md }}</h3>
  <p class="meta center"><span class="level">C1 · {{ sizes.real_english | minutes }} min</span></p>
  <div class="grid2">
    <article>
      <h4>{{ t.view_a.title }}</h4>
      {% for p in t.view_a.text | paras %}<p>{{ p | md }}</p>{% endfor %}
    </article>
    <article>
      <h4>{{ t.view_b.title }}</h4>
      {% for p in t.view_b.text | paras %}<p>{{ p | md }}</p>{% endfor %}
    </article>
  </div>
{% else %}{% set s = c.say_it_better %}
  <h2 class="kicker">Real English · Say It Better · {{ plan.setting | title }}</h2>
  <h3>{{ s.situation_title | md }}</h3>
  {{ meta("B2", sizes.real_english) }}
  <p>{{ s.situation | md }}</p>
  <div class="table-wrap"><table>
    <thead><tr><th>Register</th><th>How to say it</th></tr></thead>
    <tbody>
      <tr><td>Formal</td><td>{{ s.formal | md }}</td></tr>
      <tr><td>Neutral</td><td>{{ s.neutral | md }}</td></tr>
      <tr><td>Casual</td><td>{{ s.casual | md }}</td></tr>
    </tbody>
  </table></div>
{% endif %}
  <div class="pair" style="margin-top:16px">
    <div class="box">
      {% if c.two_takes %}
      <h4>Argument Phrases</h4>
      <ul>{% for ph in c.two_takes.phrases %}<li><strong>{{ ph.phrase | plain }}</strong> — {{ ph.function }}</li>{% endfor %}</ul>
      {% else %}
      <h4>Useful Phrases</h4>
      <ul>{% for ph in c.say_it_better.useful_phrases %}<li>{{ ph | md }}</li>{% endfor %}</ul>
      {% endif %}
    </div>
    <div class="box">
      <h4>Thai Speaker's Trap</h4>
      <p class="small-label">{{ plan.trap }}</p>
      <p><strong>{{ c.trap.title | plain }}</strong></p>
      <p class="wrong">{{ c.trap.wrong | plain }}</p>
      <p class="right">{{ c.trap.right | plain }}</p>
      <p>{{ c.trap.explanation | thai }}</p>
    </div>
  </div>
</section>

<section>
  <h2 class="kicker">Language Lab</h2>
  <div class="lab">
    <div>
      <h4>{{ plan.activity }}</h4>
      <p class="inst">{{ c.activity.instructions | md }}</p>
      <ol>{% for it in c.activity["items"] %}<li>{{ it | md }}</li>{% endfor %}</ol>
    </div>
    <div>
      <h4>Error Identification</h4>
      <p class="inst">Each sentence has one mistake. Find it and correct it.</p>
      <ol>{% for e in c.errors %}<li>{{ e.sentence | plain }}</li>{% endfor %}</ol>
    </div>
  </div>
</section>

{% set n_star = c.star_words | length %}
<section>
  <h2 class="kicker">Word Bank</h2>
  <p class="inst">&#9733; today's new words, in <strong>bold</strong> in the articles · &#8634; review words from earlier days · tap <em>ไทย</em> for the Thai meaning</p>
  <div class="wb-grid">
    {% for g in c.word_bank[:n_star] %}<div class="wb-card">
      <div class="wb-head">
        <span><span class="wb-word">&#9733; {{ g.word }}</span> <span class="wb-pos">{{ g.pos }}</span></span>
        <details class="th"><summary>ไทย</summary><span class="wb-thai" lang="th">{{ g.thai }}</span></details>
      </div>
      <p class="wb-def">{{ g.definition | plain }}</p>
      {% if g.collocations %}<p class="wb-coll"><span class="small-label">Collocations</span> {{ g.collocations | join(" · ") }}</p>{% endif %}
      {% if g.example %}<p class="ex">“{{ g.example | md }}”</p>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% if c.word_bank[n_star:] %}
  <div class="box wb-review">
    <h4>Review Words</h4>
    <ul>
      {% for g in c.word_bank[n_star:] %}<li><span class="rw"><strong>{{ g.word }}</strong></span> <span class="wb-pos">{{ g.pos }}</span> · {{ g.definition | plain }} <details class="th"><summary>ไทย</summary><span lang="th">{{ g.thai }}</span></details>{% if review_from.get(g.word | lower) %} <small>(from {{ review_from[g.word | lower] }})</small>{% endif %}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</section>

{% set ol = c.other_language %}
<section>
  <h2 class="kicker">Other Languages · {{ plan.language }}</h2>
  <h3>{{ plan.phrase_theme | capitalize }}</h3>
  <p>{{ ol.theme_intro | plain }}</p>
  <div class="table-wrap"><table>
    <thead><tr><th>{{ plan.language }}</th><th>Say it like</th><th>Meaning</th></tr></thead>
    <tbody>
      {% for ph in ol.phrases %}<tr><td lang="{{ lang_code }}"><strong>{{ ph.phrase }}</strong></td><td>{{ ph.pronunciation }}</td><td>{{ ph.meaning }}</td></tr>
      {% endfor %}
    </tbody>
  </table></div>
  <div class="grid3" style="margin-top:16px">
    <div class="box">
      <h4>Word Root</h4>
      <p><strong lang="{{ lang_code }}">{{ ol.root.root }}</strong> = {{ ol.root.meaning }}</p>
      <p><span class="small-label">In English</span> {{ ol.root.english_words }}</p>
      <p class="ex">{{ ol.root.note | plain }}</p>
    </div>
    <div class="box">
      <h4>Borrowed into English</h4>
      <p><strong>{{ ol.borrowed.word }}</strong></p>
      <p>{{ ol.borrowed.note | plain }}</p>
    </div>
    <div class="box">
      <h4>Curious Word</h4>
      <p><strong lang="{{ lang_code }}">{{ ol.curious.word }}</strong> <span class="wb-pos">{{ ol.curious.pronunciation }}</span></p>
      <p>{{ ol.curious.meaning }}</p>
      <p class="ex">{{ ol.curious.note | plain }}</p>
    </div>
  </div>
</section>

<section>
  <details>
    <summary>Answer Key · tap to reveal</summary>
    <h4>{{ plan.activity }}</h4>
    <ol>{% for a in c.activity.answers %}<li>{{ a | md }}</li>{% endfor %}</ol>
    <h4 style="margin-top:12px">Error Identification</h4>
    <ol>{% for e in c.errors %}<li>{{ e.corrected | plain }} — <em>{{ e.reason | plain }}</em></li>{% endfor %}</ol>
  </details>
</section>

<section class="sources">
  <h2 class="kicker">Sources</h2>
  <ol>
    {% for s in sources %}<li><a href="{{ s.url }}" rel="noopener">{{ s.source }} — {{ s.title }}</a></li>
    {% endfor %}
  </ol>
</section>
{% endblock %}

{% block footer %}{{ paper }} · {{ plan.date_long }} · Written with AI from the sources listed above{% endblock %}
