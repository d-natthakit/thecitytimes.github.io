{% extends "base.html.j2" %}
{# Layout used by issues 1–2 (before 29 Oct 2026). Kept so old pages still build. #}
{% block title %}{{ paper }} · {{ plan.date_long }}{% endblock %}
{% block description %}{{ plan.date_long }}: {{ c.cover.headline | plain }}{% endblock %}
{% block nav %}{% if prev %}<a href="{{ root }}issues/{{ prev }}.html">&larr; Previous day</a>{% endif %}{% endblock %}
{% block dateline %}
    <span>{{ plan.date_long }}</span>
    <span>Bangkok Edition</span>
{% endblock %}

{% macro meta(level, words) -%}
<p class="meta"><span class="level">{{ level }} · {{ words | minutes }} min</span></p>
{%- endmacro %}

{% macro article(a, level, words) -%}
<article>
  <h3>{{ a.headline | md }}</h3>
  {{ meta(level, words) }}
  {% for p in a.paragraphs %}<p>{{ p | md }}</p>
  {% endfor %}
</article>
{%- endmacro %}

{% block content %}
<section class="pair">
  <div class="box">
    <h4>Quick Route</h4>
    <ul>
      {% for b in c.quick_route %}<li>{{ b | md }}</li>
      {% endfor %}
    </ul>
  </div>
  <div class="box">
    <h4>Today's Words</h4>
    <ul class="wordlist">
      {% for w in c.star_words %}<li>{{ w }}</li>{% endfor %}
    </ul>
  </div>
</section>

<section class="cover">
  <h2 class="kicker">Cover Story</h2>
  <article>
    <h3>{{ c.cover.headline | md }}</h3>
    {{ meta("C1", sizes.cover) }}
    <div class="cols">
      {% for p in c.cover.paragraphs %}<p{% if loop.first %} class="dropcap"{% endif %}>{{ p | md }}</p>
      {% endfor %}
    </div>
  </article>
</section>

<section class="grid2">
  <div class="stack">
    <h2 class="kicker">World in Brief</h2>
    {% for a in c.world %}{{ article(a, "B1+", sizes["world_" ~ loop.index]) }}
    {% endfor %}
  </div>
  <div class="stack">
    <h2 class="kicker">Thailand Today</h2>
    {% for a in c.thailand %}{{ article(a, "B1+", sizes["thailand_" ~ loop.index]) }}
    {% endfor %}
  </div>
</section>

<section class="grid2">
  <div>
    <h2 class="kicker">Feature · {{ plan.feature_a }}</h2>
    {{ article(c.feature_a, "B2", sizes.feature_a) }}
  </div>
  <div>
    <h2 class="kicker">Feature · {{ plan.feature_b }}</h2>
    {{ article(c.feature_b, "B2", sizes.feature_b) }}
  </div>
</section>

{% if c.two_takes %}{% set t = c.two_takes %}
<section>
  <h2 class="kicker">Two Takes</h2>
  <h3 class="center">{{ t.question | md }}</h3>
  <p class="meta center"><span class="level">C1 · {{ sizes.opinion | minutes }} min</span></p>
  <div class="grid2">
    <article>
      <h4>{{ t.view_a.title }}</h4>
      {% for p in t.view_a.text | paras %}<p>{{ p | md }}</p>{% endfor %}
    </article>
    <article>
      <h4>{{ t.view_b.title }}</h4>
      {% for p in t.view_b.text | paras %}<p>{{ p | md }}</p>{% endfor %}
    </article>
  </div>
  <div class="box" style="margin-top:16px">
    <h4>Argument Phrases</h4>
    <ul>
      {% for ph in t.phrases %}<li><strong>{{ ph.phrase | plain }}</strong> — {{ ph.function }}</li>
      {% endfor %}
    </ul>
  </div>
</section>
{% else %}{% set s = c.say_it_better %}
<section>
  <h2 class="kicker">Say It Better · {{ plan.setting | title }}</h2>
  <h3>{{ s.situation_title | md }}</h3>
  {{ meta("B2", sizes.opinion) }}
  <p>{{ s.situation | md }}</p>
  <div class="table-wrap"><table>
    <thead><tr><th>Register</th><th>How to say it</th></tr></thead>
    <tbody>
      <tr><td>Formal</td><td>{{ s.formal | md }}</td></tr>
      <tr><td>Neutral</td><td>{{ s.neutral | md }}</td></tr>
      <tr><td>Casual</td><td>{{ s.casual | md }}</td></tr>
    </tbody>
  </table></div>
  <div class="pair" style="margin-top:16px">
    <div class="box">
      <h4>Useful Phrases</h4>
      <ul>{% for ph in s.useful_phrases %}<li>{{ ph | md }}</li>{% endfor %}</ul>
    </div>
    <div class="box">
      <h4>Avoid This</h4>
      <p class="wrong">{{ s.avoid.phrase | plain }}</p>
      <p>{{ s.avoid.reason | md }}</p>
    </div>
  </div>
</section>
{% endif %}

<section>
  <h2 class="kicker">Language Lab</h2>
  <div class="lab">
    <div>
      <h4>Word Workshop</h4>
      <dl class="ww">
        {% for w in c.word_workshop %}<dt>{{ w.word }}</dt>
        <dd>{{ w.collocations | join(" · ") }}<br><span class="ex">{{ w.example | md }}</span></dd>
        {% endfor %}
      </dl>
    </div>
    <div>
      <h4>{{ plan.activity }}</h4>
      <p class="inst">{{ c.activity.instructions | md }}</p>
      <ol>{% for it in c.activity["items"] %}<li>{{ it | md }}</li>{% endfor %}</ol>
    </div>
    <div>
      <h4>Error Identification</h4>
      <p class="inst">Each sentence has one mistake. Find it and correct it.</p>
      <ol>{% for e in c.errors %}<li>{{ e.sentence | plain }}</li>{% endfor %}</ol>
    </div>
    <div>
      <h4>Thai Speaker's Trap · {{ plan.trap }}</h4>
      <p><strong>{{ c.trap.title | plain }}</strong></p>
      <p class="wrong">{{ c.trap.wrong | plain }}</p>
      <p class="right">{{ c.trap.right | plain }}</p>
      <p>{{ c.trap.explanation | thai }}</p>
    </div>
  </div>
</section>

<section>
  <h2 class="kicker">Other Languages · {{ plan.language }}</h2>
  <article>
    <h3>{{ c.other_language.headline | plain }}</h3>
    {% for p in c.other_language.note | paras %}<p>{{ p | plain }}</p>{% endfor %}
    <div class="table-wrap"><table>
      <thead><tr><th>Phrase</th><th>Say it like</th><th>Meaning</th></tr></thead>
      <tbody>
        {% for ph in c.other_language.phrases %}<tr><td lang="{{ lang_code }}">{{ ph.phrase }}</td><td>{{ ph.pronunciation }}</td><td>{{ ph.meaning }}</td></tr>
        {% endfor %}
      </tbody>
    </table></div>
    <p style="margin-top:12px"><strong>Borrowed into English:</strong> {{ c.other_language.borrowed.word }} — {{ c.other_language.borrowed.note | plain }}</p>
  </article>
</section>

<section>
  <h2 class="kicker">Glossary</h2>
  <div class="table-wrap"><table class="glossary">
    <thead><tr><th>Word</th><th>Meaning</th><th>Thai</th><th>In today's issue</th></tr></thead>
    <tbody>
      {% for g in c.glossary %}<tr>
        <td>{% if loop.index <= 8 %}<strong>&#9733; {{ g.word }}</strong>{% else %}<span class="rw">{{ g.word }}</span>{% endif %} <em>({{ g.pos }})</em>{% if loop.index > 8 and review_from.get(g.word | lower) %}<br><small>from {{ review_from[g.word | lower] }}</small>{% endif %}</td>
        <td>{{ g.definition | plain }}</td>
        <td lang="th">{{ g.thai }}</td>
        <td class="ex">{{ g.example | md }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table></div>
</section>

<section>
  <details>
    <summary>Answer Key · tap to reveal</summary>
    <h4>{{ plan.activity }}</h4>
    <ol>{% for a in c.activity.answers %}<li>{{ a | md }}</li>{% endfor %}</ol>
    <h4 style="margin-top:12px">Error Identification</h4>
    <ol>{% for e in c.errors %}<li>{{ e.corrected | plain }} — <em>{{ e.reason | plain }}</em></li>{% endfor %}</ol>
  </details>
</section>

<section class="sources">
  <h2 class="kicker">Sources</h2>
  <ol>
    {% for s in sources %}<li><a href="{{ s.url }}" rel="noopener">{{ s.source }} — {{ s.title }}</a></li>
    {% endfor %}
  </ol>
</section>
{% endblock %}

{% block footer %}{{ paper }} · {{ plan.date_long }} · Written with AI from the sources listed above{% endblock %}
