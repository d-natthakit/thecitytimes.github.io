<!DOCTYPE html>
<html lang="en" data-theme="sepia">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ paper }}{% endblock %}</title>
<meta name="description" content="{% block description %}A daily English-learning newspaper for Thai working adults (CEFR B1+ to C1).{% endblock %}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&family=Playfair+Display:wght@700;900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,700;1,8..60,400&family=Noto+Serif+Thai:wght@400;600&display=swap" rel="stylesheet">
<style>
{% include "style.css" %}
</style>
</head>
<body>
<div class="page">

<div class="toolbar">
  <nav>
    <a href="{{ root }}index.html">Today</a>
    <a href="{{ root }}archive.html">Archive</a>
    {% block nav %}{% endblock %}
  </nav>
  <button id="themeBtn" type="button">Black &amp; White</button>
</div>

<header class="masthead">
  <div class="ears">
    <span>Daily English for<br>Thai Professionals</span>
    <span>Levels B1+ to C1<br>About 25 minutes</span>
  </div>
  <h1 class="title">The BKK Gem Post</h1>
  <div class="dateline">
    {% block dateline %}<span>Bangkok Edition</span>{% endblock %}
  </div>
</header>

{% block content %}{% endblock %}

<footer>{% block footer %}{{ paper }}{% endblock %}</footer>

</div>
<script>
{% include "theme.js" %}
</script>
</body>
</html>
